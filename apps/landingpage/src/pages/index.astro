---
import Layout from '@/components/layout.astro';
import WaitlistForm from '@/components/WaitlistForm';

const title = 'excited.live — Plan the life you want to live';
const description =
	'Simulate your money and life plans before you live them. Tax, expenses, and future scenarios — free for everyone. Join the waitlist.';
---

<Layout title={title} description={description}>
	<!-- ============ NAV ============ -->
	<div class="nav-wrap">
		<nav class="nav-pill" aria-label="Main">
			<a class="nav-brand" href="/">
				<img src="/logo-mark.png" alt="" width="28" height="28" />
				<span>excited<span class="brand-dot">.live</span></span>
			</a>
			<div class="nav-links">
				<a href="#what">
					<span data-lang-en>What is it</span>
					<span data-lang-th>มันคืออะไร</span>
				</a>
				<a href="#perks">
					<span data-lang-en>Why join</span>
					<span data-lang-th>ทำไมต้องลง</span>
				</a>
				<a href="/docs">
					<span data-lang-en>Docs</span>
					<span data-lang-th>เอกสาร</span>
				</a>
			</div>
			<div class="nav-actions">
				<div class="lang-toggle" role="group" aria-label="Language">
					<button type="button" data-set-lang="en">EN</button>
					<button type="button" data-set-lang="th">ไทย</button>
				</div>
				<a class="btn-ink" href="#waitlist">
					<span data-lang-en>Join waitlist</span>
					<span data-lang-th>ลงทะเบียน</span>
				</a>
			</div>
		</nav>
	</div>

	<!-- ============ HERO ============ -->
	<header class="hero" id="waitlist">
		<div class="hero-graph" aria-hidden="true">
			<svg viewBox="0 0 460 340">
				<g class="grid">
					<line x1="20" y1="70" x2="440" y2="70" />
					<line x1="20" y1="145" x2="440" y2="145" />
					<line x1="20" y1="220" x2="440" y2="220" />
					<line x1="20" y1="295" x2="440" y2="295" />
				</g>
				<path
					class="area"
					d="M20 295 C 90 288, 150 262, 200 240 C 260 214, 300 175, 350 140 C 385 115, 415 85, 440 62 L440 295 Z"
				/>
				<path
					class="line-proj"
					d="M20 295 C 110 282, 200 262, 290 252 C 350 245, 405 240, 440 236"
				/>
				<path
					class="line-main"
					d="M20 295 C 90 288, 150 262, 200 240 C 260 214, 300 175, 350 140 C 385 115, 415 85, 440 62"
				/>
				<circle class="dot-halo" cx="440" cy="62" r="13" />
				<circle class="dot" cx="440" cy="62" r="6" />
				<text class="axis" x="20" y="322">2026</text>
				<text class="axis" x="400" y="322">2036</text>
			</svg>
			<span class="hero-chip chip-goal">
				<span data-lang-en>Buy a condo · 2031</span>
				<span data-lang-th>ซื้อคอนโด · 2031</span>
			</span>
			<span class="hero-chip chip-reached">
				<span data-lang-en>Goal reached ✓</span>
				<span data-lang-th>ถึงเป้าหมาย ✓</span>
			</span>
		</div>
		<div class="hero-inner">
			<p class="eyebrow">
				<span data-lang-en>Coming soon</span>
				<span data-lang-th>เร็ว ๆ นี้</span>
			</p>
			<h1>
				<span data-lang-en>Plan the life<br />you want to <span class="accent">live</span></span>
				<span data-lang-th>วางแผนชีวิตแบบ<br />ที่คุณอยาก<span class="accent">ใช้ชีวิต</span></span>
			</h1>
			<p class="hero-sub">
				<span data-lang-en>
					Simulate your money and your plans before you live them — tax, expenses, and life
					goals. Free for everyone.
				</span>
				<span data-lang-th>
					จำลองการเงินและแผนชีวิตของคุณก่อนใช้จริง — ภาษี ค่าใช้จ่าย และเป้าหมายต่าง ๆ
					ฟรีสำหรับทุกคน
				</span>
			</p>
			<div class="hero-perks">
				<span class="perk-chip">
					<span class="dot"></span>
					<span data-lang-en>Battle-tested math</span>
					<span data-lang-th>คณิตที่พิสูจน์แล้ว</span>
				</span>
				<span class="perk-chip">
					<span class="dot"></span>
					<span data-lang-en>AI native</span>
					<span data-lang-th>AI เนทีฟ</span>
				</span>
				<span class="perk-chip">
					<span class="dot"></span>
					<span data-lang-en>Data safe</span>
					<span data-lang-th>ข้อมูลปลอดภัย</span>
				</span>
			</div>
			<WaitlistForm client:visible />
		</div>
	</header>

	<!-- ============ WHAT IS IT ============ -->
	<section class="section" id="what">
		<div class="section-head">
			<p class="eyebrow">
				<span data-lang-en>What is excited.live</span>
				<span data-lang-th>excited.live คืออะไร</span>
			</p>
			<h2>
				<span data-lang-en>Simulate your life before you live it.</span>
				<span data-lang-th>จำลองชีวิตก่อนใช้มันจริง</span>
			</h2>
			<p>
				<span data-lang-en>
					excited.live is a free financial simulation tool. Try real decisions — changing
					jobs, buying a home, retiring early — and see the numbers before you commit.
				</span>
				<span data-lang-th>
					excited.live เป็นเครื่องมือจำลองการเงินฟรี ลองการตัดสินใจจริง — เปลี่ยนงาน ซื้อบ้าน
					เกษียณเร็ว — แล้วเห็นตัวเลขก่อนลงมือทำจริง
				</span>
			</p>
		</div>

		<div class="orbit-stage">
			<svg class="orbit-svg" viewBox="0 0 1200 300" preserveAspectRatio="none" aria-hidden="true">
				<path d="M 200 170 C 420 30, 780 30, 1000 170" />
			</svg>
			<div class="orbit-item">
				<div class="orbit-circle">
					<span class="step-num">01</span>
					<span class="step-title">
						<span data-lang-en>Set goals</span>
						<span data-lang-th>กำหนดเป้าหมาย</span>
					</span>
					<span class="satellite" aria-hidden="true">🎯</span>
				</div>
				<p class="orbit-caption">
					<span data-lang-en>Tell us the life you want to live.</span>
					<span data-lang-th>บอกเป้าหมายชีวิตที่คุณอยากได้</span>
				</p>
			</div>
			<div class="orbit-item">
				<div class="orbit-circle">
					<span class="step-num">02</span>
					<span class="step-title">
						<span data-lang-en>Weigh trade-offs</span>
						<span data-lang-th>คำนวณ tradeoff</span>
					</span>
					<span class="satellite" aria-hidden="true">⚖️</span>
				</div>
				<p class="orbit-caption">
					<span data-lang-en>See what each choice really costs.</span>
					<span data-lang-th>เห็นต้นทุนจริงของทุกทางเลือก</span>
				</p>
			</div>
			<div class="orbit-item">
				<div class="orbit-circle">
					<span class="step-num">03</span>
					<span class="step-title">
						<span data-lang-en>Live</span>
						<span data-lang-th>ใช้ชีวิต</span>
					</span>
					<span class="satellite" aria-hidden="true">🌴</span>
				</div>
				<p class="orbit-caption">
					<span data-lang-en>Go live it — AI keeps your plan on track.</span>
					<span data-lang-th>ใช้ชีวิตจริง — ให้ AI ช่วยดูแลแผนให้</span>
				</p>
			</div>
		</div>
	</section>

	<!-- ============ WHY JOIN ============ -->
	<section class="section" id="perks">
		<div class="section-head">
			<p class="eyebrow">
				<span data-lang-en>Why join the waitlist</span>
				<span data-lang-th>ทำไมต้องลงทะเบียน</span>
			</p>
			<h2>
				<span data-lang-en>Be first in line when doors open.</span>
				<span data-lang-th>เป็นคนแรก ๆ ที่ได้เข้าใช้</span>
			</h2>
		</div>

		<div class="perk-cards">
			<article class="perk-card">
				<span class="perk-icon" aria-hidden="true">🚀</span>
				<h3>
					<span data-lang-en>Early access</span>
					<span data-lang-th>ลองใช้ก่อนใคร</span>
				</h3>
				<p>
					<span data-lang-en>Get your invite before the public launch.</span>
					<span data-lang-th>ได้รับเชิญก่อนเปิดให้คนทั่วไปใช้</span>
				</p>
			</article>
			<article class="perk-card">
				<span class="perk-icon" aria-hidden="true">🎁</span>
				<h3>
					<span data-lang-en>Special reward</span>
					<span data-lang-th>ของรางวัลสุดพิเศษ</span>
				</h3>
				<p>
					<span data-lang-en>Founding members get a thank-you reward at launch.</span>
					<span data-lang-th>ผู้ร่วมก่อตั้งได้ของขวัญขอบคุณตอนเปิดตัว</span>
				</p>
			</article>
			<article class="perk-card">
				<span class="perk-icon" aria-hidden="true">⭐</span>
				<h3>
					<span data-lang-en>Priority support</span>
					<span data-lang-th>ซัพพอร์ตก่อนใคร</span>
				</h3>
				<p>
					<span data-lang-en>Your questions jump the queue.</span>
					<span data-lang-th>คำถามของคุณได้รับการตอบก่อน</span>
				</p>
			</article>
		</div>
	</section>

	<!-- ============ FOOTER ============ -->
	<footer class="footer">
		<div class="footer-inner">
			<h2>
				<span data-lang-en>Ready to live the life you're excited about?</span>
				<span data-lang-th>พร้อมใช้ชีวิตแบบที่คุณตั้งตารอแล้วหรือยัง?</span>
			</h2>
			<WaitlistForm client:visible dark />

			<div class="journey">
				<p class="eyebrow">
					<span data-lang-en>Follow the journey</span>
					<span data-lang-th>ติดตามเส้นทางของเรา</span>
				</p>
				<div class="journey-links">
					<a
						class="journey-link is-live"
						href="https://www.instagram.com/excited.live/"
						rel="noopener noreferrer"
					>
						Instagram
					</a>
					<span class="journey-link is-soon">
						YouTube
						<em>
							<span data-lang-en>soon</span>
							<span data-lang-th>เร็ว ๆ นี้</span>
						</em>
					</span>
					<span class="journey-link is-soon">
						X
						<em>
							<span data-lang-en>soon</span>
							<span data-lang-th>เร็ว ๆ นี้</span>
						</em>
					</span>
					<span class="journey-link is-soon">
						Threads
						<em>
							<span data-lang-en>soon</span>
							<span data-lang-th>เร็ว ๆ นี้</span>
						</em>
					</span>
				</div>
			</div>

			<div class="footer-cols">
				<div class="footer-col">
					<h4>
						<span data-lang-en>Product</span>
						<span data-lang-th>ผลิตภัณฑ์</span>
					</h4>
					<a href="#what">
						<span data-lang-en>What is it</span>
						<span data-lang-th>มันคืออะไร</span>
					</a>
					<a href="#perks">
						<span data-lang-en>Why join</span>
						<span data-lang-th>ทำไมต้องลง</span>
					</a>
					<a href="/docs">
						<span data-lang-en>Docs</span>
						<span data-lang-th>เอกสาร</span>
					</a>
				</div>
				<div class="footer-col">
					<h4>
						<span data-lang-en>Creator</span>
						<span data-lang-th>ผู้สร้าง</span>
					</h4>
					<a href="https://fromsukong.com" rel="noopener noreferrer">FromSukong</a>
					<a href="https://github.com/fromsukong/excited.live" rel="noopener noreferrer">
						GitHub</a
					>
				</div>
			</div>

			<div class="footer-bottom">
				<span>© 2026 FromSukong · <span data-lang-en>Made in Bangkok</span>
					<span data-lang-th>ทำในกรุงเทพฯ</span></span>
				<span class="legal-links">
					<a href="/docs/privacy">
						<span data-lang-en>Privacy</span>
						<span data-lang-th>ความเป็นส่วนตัว</span>
					</a>
					<a href="/docs/terms">
						<span data-lang-en>Terms</span>
						<span data-lang-th>เงื่อนไข</span>
					</a>
				</span>
				<div class="lang-toggle" role="group" aria-label="Language">
					<button type="button" data-set-lang="en">EN</button>
					<button type="button" data-set-lang="th">ไทย</button>
				</div>
			</div>
		</div>
	</footer>

	<script is:inline>
		// Pure-CSS bilingual toggle: flips <html data-lang>, persists to localStorage.
		document.addEventListener('click', function (event) {
			const target = event.target.closest('[data-set-lang]');
			if (!target) return;
			const lang = target.getAttribute('data-set-lang');
			document.documentElement.dataset.lang = lang;
			try {
				localStorage.setItem('exl-lang', lang);
			} catch {
				/* private mode — toggle still works for this page view */
			}
		});
	</script>
</Layout>
