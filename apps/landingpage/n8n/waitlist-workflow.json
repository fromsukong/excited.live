{
	"name": "excited.live — Waitlist",
	"active": false,
	"settings": {
		"executionOrder": "v1"
	},
	"nodes": [
		{
			"parameters": {
				"httpMethod": "POST",
				"path": "waitlist",
				"responseMode": "responseNode",
				"options": {
					"allowedOrigins": "https://excited.live, https://www.excited.live, https://excited-live-prelive.pages.dev, https://excited-live-landing-preview.pages.dev, http://localhost:4321"
				}
			},
			"id": "a1b2c3d4-0001-4000-8000-000000000001",
			"name": "Waitlist Webhook",
			"type": "n8n-nodes-base.webhook",
			"typeVersion": 2,
			"position": [0, 0],
			"webhookId": "waitlist"
		},
		{
			"parameters": {
				"mode": "manual",
				"includeOtherFields": false,
				"assignments": {
					"assignments": [
						{
							"id": "f1",
							"name": "email",
							"value": "={{ ($json.body.email || '').trim().toLowerCase() }}",
							"type": "string"
						},
						{
							"id": "f2",
							"name": "source",
							"value": "={{ $json.body.source || 'landing' }}",
							"type": "string"
						},
						{
							"id": "f3",
							"name": "receivedAt",
							"value": "={{ $now.toISO() }}",
							"type": "string"
						},
						{
							"id": "f4",
							"name": "userAgent",
							"value": "={{ $json.headers['user-agent'] || '' }}",
							"type": "string"
						}
					]
				}
			},
			"id": "a1b2c3d4-0002-4000-8000-000000000002",
			"name": "Normalize",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [220, 0]
		},
		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"version": 2
					},
					"combinator": "and",
					"conditions": [
						{
							"id": "c1",
							"leftValue": "={{ $json.email }}",
							"rightValue": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$",
							"operator": {
								"type": "string",
								"operation": "regex"
							}
						}
					]
				}
			},
			"id": "a1b2c3d4-0003-4000-8000-000000000003",
			"name": "Valid email?",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [440, 0]
		},
		{
			"parameters": {
				"operation": "append",
				"documentId": {
					"__rl": true,
					"mode": "list",
					"value": ""
				},
				"sheetName": {
					"__rl": true,
					"mode": "list",
					"value": ""
				},
				"columns": {
					"mappingMode": "autoMapInputData",
					"value": {}
				},
				"options": {}
			},
			"id": "a1b2c3d4-0004-4000-8000-000000000004",
			"name": "Append to Sheet",
			"type": "n8n-nodes-base.googleSheets",
			"typeVersion": 4.5,
			"position": [660, -80]
		},
		{
			"parameters": {
				"respondWith": "json",
				"responseBody": "={{ { ok: true } }}",
				"options": {
					"responseCode": 200
				}
			},
			"id": "a1b2c3d4-0005-4000-8000-000000000005",
			"name": "OK",
			"type": "n8n-nodes-base.respondToWebhook",
			"typeVersion": 1.1,
			"position": [880, -80]
		},
		{
			"parameters": {
				"respondWith": "json",
				"responseBody": "={{ { ok: false, error: 'invalid_email' } }}",
				"options": {
					"responseCode": 400
				}
			},
			"id": "a1b2c3d4-0006-4000-8000-000000000006",
			"name": "Rejected",
			"type": "n8n-nodes-base.respondToWebhook",
			"typeVersion": 1.1,
			"position": [660, 120]
		}
	],
	"connections": {
		"Waitlist Webhook": {
			"main": [
				[
					{
						"node": "Normalize",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Normalize": {
			"main": [
				[
					{
						"node": "Valid email?",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Valid email?": {
			"main": [
				[
					{
						"node": "Append to Sheet",
						"type": "main",
						"index": 0
					}
				],
				[
					{
						"node": "Rejected",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Append to Sheet": {
			"main": [
				[
					{
						"node": "OK",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	}
}
