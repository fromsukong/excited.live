{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "excited Tax",
	"version": "0.0.1",
	"identifier": "live.excited.tax",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "excited Tax",
				"width": 420,
				"height": 840,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png"
		]
	}
}
