{
	"name": "@excited-live/design-system",
	"version": "0.0.1",
	"description": "excited.live design system: zero-style primitives, icons, and Astryx re-exports for app UIs",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./mastercard-theme.css": "./src/mastercard-theme.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"theme:build": "astryx theme build src/mastercardTheme.ts -o src/mastercard-theme.css",
		"theme:check": "astryx theme build src/mastercardTheme.ts -o src/mastercard-theme.css --check"
	},
	"peerDependencies": {
		"@astryxdesign/core": "catalog:",
		"react": "catalog:"
	},
	"devDependencies": {
		"@astryxdesign/cli": "catalog:",
		"@astryxdesign/core": "catalog:",
		"@types/react": "catalog:",
		"react": "catalog:",
		"tsup": "catalog:",
		"typescript": "catalog:"
	}
}
