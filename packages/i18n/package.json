{
	"name": "@excited-live/i18n",
	"version": "0.0.1",
	"description": "Bilingual (en/th) i18n: dictionaries, translator, locale detection helpers",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsup",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"tsup": "^8.5.0",
		"typescript": "^5.8.3",
		"vitest": "^3.2.0"
	}
}
